generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  user_id      String         @id @default(uuid())
  username     String
  email        String         @unique
  password     String
  role         String         @default("user")
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  schedules    schedules[]
  teachers     teachers?
  testimonials testimonials[]
}

model testimonials {
  id         Int      @id @default(autoincrement())
  name       String
  verse      String
  created_by String
  updated_at DateTime @updatedAt
  content    String
  created_at DateTime @default(now())
  user_id    String
  user       users    @relation(fields: [user_id], references: [user_id])

  @@index([created_by], map: "testimonials_created_by_fkey")
}

model event_type {
  id         Int         @id @default(autoincrement())
  name       String
  created_at DateTime    @default(now())
  updated_at DateTime?   @updatedAt
  schedules  schedules[]
}

model teachers {
  teacher_id       String             @id @default(uuid())
  name             String
  user_id          String             @unique
  image            String
  description      String?
  quotes           String?
  verse            String?
  verse_content    String?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  schedule_details schedule_details[]
  user             users              @relation(fields: [user_id], references: [user_id])
}

model schedules {
  schedule_id      Int               @id @default(autoincrement())
  event_title      String
  event_type_id    Int
  start_date       DateTime
  end_date         DateTime
  is_teaching      Boolean
  created_by       String
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  schedule_details schedule_details?
  user             users             @relation(fields: [created_by], references: [user_id])
  event_type       event_type        @relation(fields: [event_type_id], references: [id])
}

model schedule_details {
  schedule_id     Int       @id
  location        String
  teacher_id      String?
  audio_source    String?
  document_source String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  zoom_link       String?
  schedule        schedules @relation(fields: [schedule_id], references: [schedule_id])
  teacher         teachers? @relation(fields: [teacher_id], references: [teacher_id])
}
